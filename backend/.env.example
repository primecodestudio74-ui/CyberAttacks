# HackAware Backend Environment
# Copy to .env and fill in values

# MongoDB
MONGO_URI=mongodb://localhost:27017/hackaware
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/hackaware

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server
PORT=5000
NODE_ENV=development

# CORS - comma-separated allowed origins (leave empty for open)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chatbot - OpenRouter
# Get key from https://openrouter.ai/keys
# Must start with sk-or-v1-
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override model (default: openrouter/free which auto-routes to free models)
# Examples: meta-llama/llama-3.2-3b-instruct:free, meta-llama/llama-3.3-70b-instruct:free
CHATBOT_MODEL=openrouter/free

# Optional: comma-separated fallback models
# CHATBOT_FALLBACK_MODELS=meta-llama/llama-3.2-3b-instruct:free,google/gemma-3-4b-it:free

# Optional: max tokens per response (default 1400)
CHATBOT_MAX_TOKENS=1400

# Optional: disable local fallback (default enabled) - set to 'off' to disable
CHATBOT_ENABLE_LOCAL_FALLBACK=on

# Optional: OpenRouter site URL for attribution
OPENROUTER_SITE_URL=http://localhost:5173

# News
NEWS_WARM_ON_START=on

# Allow server to start without DB (for previewing news feature)
ALLOW_START_WITHOUT_DB=0

# Trust proxy hops (for rate limiting behind proxy)
TRUST_PROXY_HOPS=1
