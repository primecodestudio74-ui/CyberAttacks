# ---------------------------------------------------------------------------
# HackAware backend environment
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# ---------------------------------------------------------------------------

PORT=5000

# MongoDB (accounts + learning progress). Optional for the Cyber News feature:
# set ALLOW_START_WITHOUT_DB=1 to run the API without a database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-string

# --- Cyber Security Chatbot (backend/services/aiService.js) ----------------
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
CHATBOT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173

# --- Cyber News -------------------------------------------------------------
# The news provider (curated publisher feeds + CISA advisories) needs NO API key.
# Everything below is optional tuning.

# How long a fetched newswire is served before it is refreshed in the background.
NEWS_CACHE_TTL_SECONDS=600
# How long stale articles may still be served while the provider is unreachable.
NEWS_STALE_GRACE_SECONDS=21600
# Minimum gap between two upstream refreshes (protects publisher bandwidth).
NEWS_MIN_REFRESH_INTERVAL_SECONDS=60
# Optional background refresh every N minutes (0 = only refresh on demand).
NEWS_BACKGROUND_REFRESH_MINUTES=0
# Fetch articles once at server start so the first visitor sees content.
NEWS_WARM_ON_START=on

# Page sizes / limits
NEWS_DEFAULT_PAGE_SIZE=12
NEWS_MAX_PAGE_SIZE=30

# Provider request tuning
NEWS_FETCH_TIMEOUT_MS=9000
NEWS_FETCH_CONCURRENCY=5
NEWS_MAX_FEED_BYTES=3500000
NEWS_EXCERPT_LENGTH=260

# Fill in missing thumbnails by reading the publisher's own article metadata
# (bounded, background only, same-host URLs only). Set to "off" to disable.
NEWS_IMAGE_ENRICHMENT=on
NEWS_IMAGE_ENRICH_LIMIT=10

# Rate limits for the public news endpoints (per IP, per minute)
NEWS_RATE_LIMIT_PER_MINUTE=60
NEWS_REFRESH_RATE_LIMIT_PER_MINUTE=6

# Restrict browser origins in production, e.g. https://hackaware.example
CORS_ORIGINS=
# Number of trusted proxy hops in front of Express (rate-limit client IPs)
TRUST_PROXY_HOPS=1

# --- Advanced / development ------------------------------------------------
# Replace the source registry with your own JSON array of feeds (same shape as
# backend/config/newsConfig.js). Used by the offline sample server and tests.
# NEWS_FEEDS_JSON=[]
# Comma-separated source ids to disable, e.g. cisa-kev,the-register-security
# NEWS_DISABLED_SOURCES=
# Allow http://127.0.0.1 feed URLs (offline sample server / tests only).
# NEWS_ALLOW_LOCAL_FEEDS=0
# Mark responses as sample data so the UI shows a clear "sample data" chip.
# NEWS_SAMPLE_MODE=0
# Run without MongoDB (news endpoints keep working; auth/learning return errors)
# ALLOW_START_WITHOUT_DB=0
