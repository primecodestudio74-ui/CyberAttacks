# ---------------------------------------------------------------------------
# HackAware frontend environment (optional). Copy to frontend/.env if needed.
# Only variables prefixed with VITE_ are exposed to the browser - never put an
# API key in one.
# ---------------------------------------------------------------------------

# Backend base URL. LEAVE EMPTY for the normal setup: the frontend then calls the
# same origin (/api/...) and the Vite dev server proxies those calls to the
# backend, which also works on preview hosts and behind a reverse proxy.
# Set it only when the API lives on a different origin, e.g.
#   VITE_API_BASE_URL=https://api.hackaware.example
VITE_API_BASE_URL=

# Dev-server proxy target for /api (defaults to http://localhost:5000)
VITE_DEV_API_TARGET=http://localhost:5000
